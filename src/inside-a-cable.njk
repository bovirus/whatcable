    <div id="question-answer" hidden aria-live="polite"><h2 id="question-title"></h2><p id="question-text"></p><button type="button" id="end-guide">Return to free exploration</button></div>
  </section>
  <p class="reference-label"><strong>Three reference designs</strong> · Compare a basic USB 2.0 cable with passive Thunderbolt 4 and Thunderbolt 5 examples. Internal construction can vary between products.</p>
  <div class="cable-picker" role="group" aria-label="Choose a cable">
    {% for id, cable in explorer.cables %}<button type="button" data-cable="{{ id }}" aria-pressed="{{ 'true' if id == 'thunderbolt' else 'false' }}"><strong>{{ cable.name }}</strong><span>{{ cable.subtitle }}</span></button>{% endfor %}
  </div>
