        <div class="stage-top"><span id="model-name">Thunderbolt 4</span><span>Reference wiring</span></div>
        <div id="scene" role="region" aria-label="Interactive cable model. Use the component buttons to explore with a keyboard."></div>
        <button type="button" id="marker-callout" hidden aria-label="Reveal and select the e-marker chip">E-marker <span>chip inside the plug</span></button>
        <p id="scene-status" role="status">Loading the 3D cable… Component descriptions are available below.</p>
        <div class="stage-bottom"><span>Drag to rotate · Scroll or pinch to zoom</span><div class="view-buttons"><button id="clear-selection" type="button" disabled>Clear selection</button><button id="connector-view" type="button" aria-pressed="false">Connector close-up</button><button id="reset-view" type="button">Reset view</button></div></div>
      </div>
